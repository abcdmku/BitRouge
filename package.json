{
  "name": "bitrouge",
  "version": "0.1.0",
  "description": "A pixel-art roguelike built on IdleBit's idle compute mechanics.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build:sprites": "tsx scripts/build-sprites.ts",
    "contact-sheet": "tsx scripts/contact-sheet.ts",
    "fetch:packs": "tsx scripts/fetch-packs.ts",
    "verify": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "phaser": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
